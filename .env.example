# Application
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=86400
DEFAULT_ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SQL Server / Windows Authentication
SQLSERVER_HOST=localhost\MSSQLSERVER01
SQLSERVER_DATABASE=AgricultureDB
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLALCHEMY_ECHO=false

# Gemini
# "configured" in /api/health only means a key/client is present; it does not verify model access.
# For a live model and Function Calling check, use /api/admin/gemini-models?probe=true as Admin.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_SDK_RETRY_ATTEMPTS=1

# OpenWeatherMap API Key (miễn phí, đăng ký tại https://home.openweathermap.org/users/sign_up)
# Để trống nếu không dùng OpenWeatherMap (hệ thống sẽ fallback sang Open-Meteo + WTTR.in)
OPENWEATHER_API_KEY=
